# ===========================================
# Docker Environment Configuration
# Copy this file to .env and customize
# ===========================================

# ===========================================
# General Configuration
# ===========================================
# Compose project name
COMPOSE_PROJECT_NAME=baileys-toolkit

# Node environment (development, production)
NODE_ENV=production

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===========================================
# Network Ports
# ===========================================
# HTTP port for nginx
HTTP_PORT=80

# HTTPS port for nginx (requires SSL setup)
HTTPS_PORT=443

# Backend API port (exposed directly, optional)
# API_PORT=3001

# ===========================================
# Web Server Configuration
# ===========================================
# JWT secret for authentication (CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin password for web interface (CHANGE THIS!)
ADMIN_PASSWORD=admin123

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost

# ===========================================
# Baileys Authentication
# ===========================================
# Path to authentication state directory
# This should be a persistent directory on your host
AUTH_PATH=./baileys_auth_info

# ===========================================
# Optional: Database Configuration
# ===========================================
# Uncomment if using PostgreSQL
# DATABASE_URL=postgresql://user:password@postgres:5432/baileys

# Uncomment if using Redis for caching
# REDIS_URL=redis://redis:6379

# ===========================================
# Optional: Build Configuration
# ===========================================
# API URL for frontend build (production)
VITE_API_URL=http://localhost:3001

# WebSocket URL for frontend build (production)
VITE_WS_URL=ws://localhost:3001

# ===========================================
# Security Headers (nginx)
# ===========================================
# Enable HSTS (HTTP Strict Transport Security)
# HSTS_ENABLED=false
# HSTS_MAX_AGE=31536000

# ===========================================
# Resource Limits (Optional)
# ===========================================
# Uncomment to set memory limits for containers
# BAILEYS_MEMORY_LIMIT=512m
# WEB_SERVER_MEMORY_LIMIT=256m
# WEB_CLIENT_MEMORY_LIMIT=128m
# NGINX_MEMORY_LIMIT=128m

# ===========================================
# Backup Configuration
# ===========================================
# Directory for automated backups
# BACKUP_DIR=./backups

# Backup retention days
# BACKUP_RETENTION_DAYS=7
