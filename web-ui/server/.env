# Server Configuration
# Port for the Express.js server
PORT=3001

# JWT Authentication
# Secret key for signing JWT tokens - MUST be changed in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Access
# Password for accessing the web interface
ADMIN_PASSWORD=admin123

# Environment
# Set to 'production' for production deployment
NODE_ENV=development

# CORS Configuration
# Origin allowed for CORS requests (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional: Custom auth directory path (relative to server directory)
# By default, uses ../../../../baileys_auth_info
# AUTH_PATH=../../../../baileys_auth_info