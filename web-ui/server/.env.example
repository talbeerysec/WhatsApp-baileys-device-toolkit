# Server Configuration
# Port for the Express.js server
PORT=3001

# JWT Authentication
# Secret key for signing JWT tokens - MUST be changed in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Access
# Password for accessing the web interface
ADMIN_PASSWORD=admin123

# Environment
# Set to 'production' for production deployment
NODE_ENV=development

# CORS Configuration
# Origin allowed for CORS requests (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional: Custom auth directory path (relative to server directory)
# By default, uses ../../../../baileys_auth_info
# AUTH_PATH=../../../../baileys_auth_info

# WhatsApp Client Browser Configuration
# Platform/OS displayed in WhatsApp's linked devices
# Options: ubuntu, macOS, windows, baileys, appropriate (auto-detect), or custom value
WHATSAPP_CLIENT_PLATFORM=@TalBeerySec WhatsApp security research client

# Browser name displayed in WhatsApp's linked devices
WHATSAPP_CLIENT_BROWSER=blabla

# Version string (optional - uses preset defaults if not specified)
WHATSAPP_CLIENT_VERSION=1.0.0